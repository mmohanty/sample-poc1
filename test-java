import org.springframework.batch.item.ExecutionContext;
import org.springframework.batch.support.SerializationUtils;
import org.springframework.core.serializer.support.SerializationFailedException;
import org.springframework.batch.core.repository.dao.ExecutionContextSerializer;

import java.io.*;

public class CustomExecutionContextSerializer implements ExecutionContextSerializer {

    @Override
    public void serialize(ExecutionContext context, OutputStream out) throws IOException {
        try (ObjectOutputStream oos = new ObjectOutputStream(out)) {
            oos.writeObject(context);
        } catch (Exception e) {
            throw new SerializationFailedException("Unable to serialize ExecutionContext", e);
        }
    }

    @Override
    public ExecutionContext deserialize(InputStream in) throws IOException {
        try (ObjectInputStream ois = new ObjectInputStream(in)) {
            return (ExecutionContext) ois.readObject();
        } catch (ClassNotFoundException e) {
            throw new SerializationFailedException("Unable to deserialize ExecutionContext", e);
        }
    }
}


import org.springframework.batch.core.repository.JobRepository;
import org.springframework.batch.core.repository.support.JobRepositoryFactoryBean;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import javax.sql.DataSource;
import org.springframework.transaction.PlatformTransactionManager;

@Configuration
public class BatchConfig {

    @Bean
    public CustomExecutionContextSerializer customExecutionContextSerializer() {
        return new CustomExecutionContextSerializer();
    }

    @Bean
    public JobRepository jobRepository(DataSource dataSource, PlatformTransactionManager transactionManager) throws Exception {
        JobRepositoryFactoryBean factory = new JobRepositoryFactoryBean();
        factory.setDataSource(dataSource);
        factory.setTransactionManager(transactionManager);
        factory.setSerializer(customExecutionContextSerializer());
        factory.afterPropertiesSet();
        return factory.getObject();
    }
}


