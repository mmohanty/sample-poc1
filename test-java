import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.batch.core.repository.dao.ExecutionContextSerializer;
import org.springframework.batch.item.ExecutionContext;

import java.io.*;

public class JsonExecutionContextSerializer implements ExecutionContextSerializer {
    private final ObjectMapper objectMapper = new ObjectMapper();

    @Override
    public void serialize(ExecutionContext context, OutputStream out) throws IOException {
        objectMapper.writeValue(out, context);
    }

    @Override
    public ExecutionContext deserialize(InputStream in) throws IOException {
        return objectMapper.readValue(in, ExecutionContext.class);
    }
}




import org.springframework.batch.core.repository.dao.JdbcExecutionContextDao;
import org.springframework.batch.item.ExecutionContext;
import javax.sql.DataSource;
import java.io.*;
import java.util.Map;

public class CustomJdbcExecutionContextDao extends JdbcExecutionContextDao {

    public CustomJdbcExecutionContextDao() {
        super();
    }

    @Override
    protected byte[] serializeContext(ExecutionContext ctx) throws IOException {
        // Custom serialization logic (e.g., JSON)
        // For demo, let's use Java serialization
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        ObjectOutputStream oos = new ObjectOutputStream(bos);
        oos.writeObject(ctx);
        oos.flush();
        return bos.toByteArray();
    }

    @Override
    @SuppressWarnings("unchecked")
    protected ExecutionContext deserializeContext(byte[] serializedContext) throws IOException {
        // Custom deserialization logic
        ByteArrayInputStream bis = new ByteArrayInputStream(serializedContext);
        ObjectInputStream ois = new ObjectInputStream(bis);
        try {
            return (ExecutionContext) ois.readObject();
        } catch (ClassNotFoundException e) {
            throw new IOException("Failed to deserialize ExecutionContext", e);
        }
    }
}


import org.springframework.batch.core.repository.support.JobRepositoryFactoryBean;
import org.springframework.batch.core.repository.JobRepository;
import org.springframework.batch.core.configuration.annotation.DefaultBatchConfigurer;
import org.springframework.context.annotation.Configuration;
import org.springframework.transaction.PlatformTransactionManager;

import javax.sql.DataSource;

@Configuration
public class BatchConfig extends DefaultBatchConfigurer {

    private final DataSource dataSource;

    public BatchConfig(DataSource dataSource) {
        this.dataSource = dataSource;
    }

    @Override
    public void setDataSource(DataSource dataSource) {
        // Override if needed
        super.setDataSource(this.dataSource);
    }

    @Override
    protected JobRepository createJobRepository() throws Exception {
        JobRepositoryFactoryBean factory = new JobRepositoryFactoryBean();
        factory.setDataSource(this.dataSource);
        factory.setTransactionManager(getTransactionManager());
        factory.setIsolationLevelForCreate("ISOLATION_READ_COMMITTED");

        // Inject custom ExecutionContext DAO
        CustomJdbcExecutionContextDao customDao = new CustomJdbcExecutionContextDao();
        customDao.setDataSource(this.dataSource);
        customDao.afterPropertiesSet();

        factory.setExecutionContextDao(customDao);
        factory.afterPropertiesSet();
        return factory.getObject();
    }

    private PlatformTransactionManager getTransactionManager() {
        return super.getTransactionManager();
    }
}





import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

public class ReadMySQLData {

    // Database credentials
    private static final String DB_URL = "jdbc:mysql://localhost:3306/your_database_name";
    private static final String DB_USER = "your_username";
    private static final String DB_PASSWORD = "your_password";

    public static void main(String[] args) {
        Connection conn = null;
        Statement stmt = null;
        ResultSet rs = null;

        try {
            // 1. Register JDBC driver (not strictly necessary for newer JDBC versions)
            Class.forName("com.mysql.cj.jdbc.Driver");

            // 2. Establish a connection to the database
            System.out.println("Connecting to database...");
            conn = DriverManager.getConnection(DB_URL, DB_USER, DB_PASSWORD);
            System.out.println("Connected successfully!");

            // 3. Create a Statement object
            stmt = conn.createStatement();
            String sql = "SELECT id, column1, column2 FROM your_table_name"; // Replace with your actual table and column names

            // 4. Execute the SQL query
            System.out.println("Executing query...");
            rs = stmt.executeQuery(sql);

            // 5. Process the ResultSet
            System.out.println("Query results:");
            while (rs.next()) {
                // Retrieve data by column name
                int id = rs.getInt("id");
                String column1Value = rs.getString("column1");
                String column2Value = rs.getString("column2");

                // Print the retrieved data
                System.out.println("ID: " + id + ", Column1: " + column1Value + ", Column2: " + column2Value);
            }

        } catch (SQLException se) {
            // Handle errors for JDBC
            se.printStackTrace();
        } catch (ClassNotFoundException cnf) {
            // Handle errors for Class.forName
            cnf.printStackTrace();
        } finally {
            // 6. Close resources (ResultSet, Statement, Connection) in reverse order
            try {
                if (rs != null) rs.close();
            } catch (SQLException se2) {
                se2.printStackTrace();
            }
            try {
                if (stmt != null) stmt.close();
            } catch (SQLException se2) {
                se2.printStackTrace();
            }
            try {
                if (conn != null) conn.close();
            } catch (SQLException se) {
                se.printStackTrace();
            }
        }
        System.out.println("Goodbye!");
    }
}
